        "jsonBody": "={{ \nJSON.stringify({\n  \"author\": \"urn:li:person:\" + $('Get Person URN').item.json.sub,\n  \"lifecycleState\": \"PUBLISHED\",\n  \"specificContent\": {\n    \"com.linkedin.ugc.ShareContent\": {\n      \"shareCommentary\": {\n        \"text\": $('Basic LLM Chain').item.json.output.post_text\n      },\n      \"shareMediaCategory\": \"IMAGE\",\n      \"media\": [\n        {\n          \"status\": \"READY\",\n          \"description\": {\n            \"text\": $('Select Manual Topic').item.json.selected_topic || \"AI Automation\"\n          },\n          \"media\": $('Register Upload').item.json.value.asset,\n          \"title\": {\n            \"text\": \"Generated Image\"\n          }\n        }\n      ]\n    }\n  },\n  \"visibility\": {\n    \"com.linkedin.ugc.MemberNetworkVisibility\": \"PUBLIC\"\n  }\n})\n}}",
