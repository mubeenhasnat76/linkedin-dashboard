    {
      "parameters": {
        "jsCode": "// --- Determine which route this execution took ---\nconst parsed = $('Parse Webhook Payload').item.json;\nconst isImagePost = parsed.generate_image === true;\n\n// --- Safely resolve the image reference ONLY if the image route ran ---\n// Referencing an unexecuted node throws, so guard with try/catch and the route flag.\nlet imageUrl = null;\nif (isImagePost) {\n  try {\n    imageUrl = $('Register Upload').item.json.value.asset || null; // LinkedIn media URN\n  } catch (e) {\n    imageUrl = null;\n  }\n}\n\nconst llmOutput = $('Basic LLM Chain').item.json.output?.post_text;\nconst topic = $('Select Manual Topic').item.json.selected_topic;\nconst item0 = ($('Edit Fields').item.json.rss?.channel?.item?.[0]) || {};\nconst linkedinResponse = $input.first()?.json || {};\n\nreturn [{\n  json: {\n    user_id: parsed.user_id || \"default-user\",\n    post_text: llmOutput || \"Automated LinkedIn Post\",\n    topic_used: topic || null,\n    article_headline: item0.title || null,\n    article_url: item0.link || null,\n    linkedin_post_id: linkedinResponse.id || null,\n    // image_url: media URN on the image route, explicit null on the text route\n    image_url: imageUrl,\n    published_at: new Date().toISOString()\n  }\n}];"
      },
