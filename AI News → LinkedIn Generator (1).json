        "jsCode": "const webhookData = $('Parse Webhook Payload').item.json;\nconst settings = $input.first()?.json || {};\n\nconst activeTopic = webhookData.topic || settings.topic || '\"Artificial Intelligence\" OR \"DevOps\"';\n\nreturn [{\n  json: {\n    selected_topic: activeTopic,\n    search_query: activeTopic\n  }\n}];"
