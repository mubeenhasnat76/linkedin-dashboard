    {
      "parameters": {
        "url": "=You are an expert AI prompt engineer specializing in creating professional LinkedIn illustrations.\n\nThe topic is:\n\n{{ $('Parse Webhook Payload').item.json.topic }}\n\nGenerate a highly descriptive image prompt for an AI image generation model.\n\nRequirements:\n\n- The image must visually represent ONLY the provided topic.\n- Do NOT generate generic AI portraits unless the topic specifically involves people.\n- Capture the main concept, technology, industry, or process.\n- Make the image suitable for a professional LinkedIn audience.\n- Modern, clean, premium digital art style.\n- Highly detailed.\n- Corporate branding quality.\n- Cinematic lighting.\n- Vibrant but realistic colors.\n- Futuristic when appropriate.\n- Use a 16:9 composition.\n- No text.\n- No letters.\n- No captions.\n- No logos.\n- No watermarks.\n- No UI screenshots.\n- No social media icons.\n- No copyright material.\n\nIf the topic is:\n\nComputer Vision\n\nGenerate scenes containing cameras, object detection, image recognition, AI vision systems, autonomous vehicles, industrial inspection, or smart surveillance.\n\nIf the topic is:\n\nClaude AI\n\nGenerate scenes showing an advanced conversational AI assistant, enterprise productivity, intelligent workflows, natural language interaction, contextual understanding, digital interfaces, and human-AI collaboration.\n\nIf the topic is:\n\nDevOps\n\nGenerate CI/CD pipelines, Kubernetes clusters, cloud infrastructure, monitoring dashboards, automation workflows, containers, servers, and software deployment.\n\nReturn ONLY the final image prompt.",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
