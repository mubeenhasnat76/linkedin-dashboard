    {
      "parameters": {
        "jsCode": "const input = $('Webhook').first().json;\n\n// Handle different payload formats\nlet parsedData;\n\nif (typeof input.body === \"string\") {\n  try {\n    parsedData = JSON.parse(input.body);\n  } catch (e) {\n    parsedData = input.body;\n  }\n} else if (input.body && typeof input.body === \"object\") {\n  parsedData = input.body;\n} else {\n  parsedData = input;\n}\n\n// Helper: strip a stray leading \"=\" the Poller sometimes sends (unevaluated expression)\nconst clean = (v) => (v === undefined || v === null) ? null : String(v).replace(/^=/, \"\").trim();\n\nconst topic = clean(parsedData.topic);\nconst postType = (clean(parsedData.post_type) || \"\").toLowerCase();\n\n// Normalize the image intent from BOTH supported shapes:\n//  - generate_image: true/\"true\"\n//  - post_type: \"image\"\nconst generateImage =\n  parsedData.generate_image === true ||\n  parsedData.generate_image === \"true\" ||\n  postType === \"image\";\n\nreturn [{\n  json: {\n    user_id: parsedData.user_id || null,\n    post_content: parsedData.post_content || null,\n    image_url: parsedData.image_url || null,\n    publish_now: parsedData.publish_now,\n    topic: topic || null,\n    post_type: postType || (generateImage ? \"image\" : \"text\"),\n    posts_per_day: parsedData.posts_per_day || null,\n    generate_image: generateImage,\n    raw_payload: parsedData\n  }\n}];"
      },
